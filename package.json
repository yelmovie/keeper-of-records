{
  "name": "keeper-of-records",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "기록의 주인 — 한국사 기록 복원형 추리·탐구 게임 (초등 5~6학년, 태블릿)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "validate:data": "node scripts/validate-history.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "verify": "npm run test && npm run validate:data && npm run validate:assets && npm run build"
  },
  "dependencies": {
    "@fontsource/jua": "^5.3.0",
    "phaser": "^3.90.0",
    "pretendard": "^1.3.9"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
